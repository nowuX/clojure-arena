{:source-paths ["src"]
 :dev-http {8081 {:host #shadow/env ["CLOJURE_ARENA_HOST" "127.0.0.1"]
                  :root "public"}}
 :builds {:app {:target :browser
                :output-dir "public/js"
                :asset-path "/js"
                :modules {:main {:init-fn clojure-arena.client/init}}
                :devtools {:before-load clojure-arena.client/stop!
                           :after-load clojure-arena.client/init}}}}
